{
  "name": "bidsvue",
  "private": true,
  "version": "0.1.20260627",
  "description": "Cross-platform desktop UI for creating, inspecting, and modifying BIDS datasets.",
  "license": "BSD-2-Clause",
  "homepage": "https://github.com/niivue/BIDSvue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niivue/BIDSvue.git"
  },
  "bugs": {
    "url": "https://github.com/niivue/BIDSvue/issues"
  },
  "type": "module",
  "scripts": {
    "predev": "bun run scripts/ensure-validator-artifacts.ts",
    "dev": "vite dev",
    "prebuild": "bun run scripts/ensure-validator-artifacts.ts",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:no-ai": "VITE_BIDSVUE_ENABLE_AI=0 BIDSVUE_DISABLE_AI=1 bun tauri dev",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check-i18n": "bun run scripts/check-i18n.ts",
    "ensure-validator-artifacts": "bun run scripts/ensure-validator-artifacts.ts",
    "fetch-sidecars": "bun run scripts/fetch-sidecars.ts",
    "test": "bun test",
    "check": "bun run ensure-validator-artifacts && bun run lint && bun run typecheck && bun run check-i18n && bun test && bun run build && bun run check:rust-fmt && bun run check:rust-test",
    "check:rust-fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "check:rust-test": "cargo test --manifest-path src-tauri/Cargo.toml --workspace --quiet",
    "bench:scanner": "bun run scripts/bench-scanner.ts",
    "spike:validator": "bun run scripts/spike-validator.ts",
    "test:e2e": "bunx wdio run tests/e2e/wdio.conf.ts",
    "release:macos": "bash scripts/macos-release.sh",
    "postinstall": "bun run scripts/patch-validator-imports.ts && bun run scripts/ensure-validator-artifacts.ts && bun run scripts/stage-sidecars.ts"
  },
  "dependencies": {
    "@bids/validator": "npm:@jsr/bids__validator@2.4.1",
    "@niivue/niivue": "file:../mono/packages/niivue",
    "gl-matrix": "^3.4.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-os": "^2",
    "@tauri-apps/plugin-store": "^2",
    "svelte-i18n": "^4"
  },
  "overrides": {
    "@niivue/dev-images": "file:../mono/packages/dev-images"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@sveltejs/adapter-static": "^3",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1",
    "@types/mocha": "^10.0.10",
    "@webgpu/types": "^0.1.52",
    "@wdio/cli": "^9.27.1",
    "@wdio/local-runner": "^9.27.1",
    "@wdio/mocha-framework": "^9.27.1",
    "@wdio/spec-reporter": "^9.27.1",
    "@wdio/types": "^9.27.1",
    "svelte": "^5",
    "svelte-check": "^4",
    "typescript": "~5.6.2",
    "vite": "^6"
  }
}
